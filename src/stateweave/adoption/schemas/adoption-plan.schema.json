{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stateweave:adoption:plan:1",
  "title": "StateWeave existing-project adoption plan 1",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "status",
    "project_id",
    "project_name",
    "deployment_mode",
    "config_path",
    "existing_entry_count",
    "existing_snapshot_sha256",
    "preserved_entry_count",
    "planned_writes",
    "conflicts",
    "warnings",
    "plan_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "adoption_plan"},
    "status": {"enum": ["safe", "blocked", "already_adopted"]},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "project_name": {"type": "string", "minLength": 1, "maxLength": 200},
    "deployment_mode": {"type": ["string", "null"], "enum": ["sidecar", "embedded", null]},
    "config_path": {
      "type": ["string", "null"],
      "enum": ["stateweave.toml", ".stateweave-project/stateweave.toml", null]
    },
    "existing_entry_count": {"type": "integer", "minimum": 0},
    "existing_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "preserved_entry_count": {"type": "integer", "minimum": 0},
    "planned_writes": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 1,
      "items": {"const": ".stateweave-project"}
    },
    "conflicts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["path", "code", "message"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 4096},
          "code": {"$ref": "#/$defs/slug"},
          "message": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 100,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "plan_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"}
  }
}
