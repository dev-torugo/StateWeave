{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stateweave:workflow:handoff:1.0",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "work_request_id",
    "producer_role",
    "receiver_role",
    "summary",
    "evidence",
    "limitations",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "handoff"},
    "id": {"type": "string", "pattern": "^HND-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"},
    "work_request_id": {
      "type": "string",
      "pattern": "^WRK-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
    },
    "producer_role": {"$ref": "#/$defs/slug"},
    "receiver_role": {"$ref": "#/$defs/slug"},
    "summary": {"type": "string", "minLength": 10, "maxLength": 20000},
    "evidence": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["kind", "locator", "strength"],
        "properties": {
          "kind": {"enum": ["test", "artifact", "observation"]},
          "locator": {"type": "string", "minLength": 1, "maxLength": 4096},
          "strength": {"enum": ["live", "synthetic", "mock"]}
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "string", "minLength": 1, "maxLength": 5000}
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    }
  }
}
