{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stateweave:capture:envelope:1",
  "title": "StateWeave persisted capture envelope 1",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "request_sha256",
    "envelope_sha256",
    "request",
    "candidates",
    "content_findings"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "capture_envelope"},
    "id": {"type": "string", "pattern": "^CAP-[a-f0-9]{64}$"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "envelope_sha256": {"$ref": "#/$defs/sha256"},
    "request": {"type": "object"},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "candidate_id",
          "candidate_request_sha256",
          "proposed_record_sha256"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "candidate_id": {"type": "string", "pattern": "^CND-[a-f0-9]{64}$"},
          "candidate_request_sha256": {"$ref": "#/$defs/sha256"},
          "proposed_record_sha256": {"$ref": "#/$defs/sha256"}
        },
        "additionalProperties": false
      }
    },
    "content_findings": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "finding": {
      "type": "object",
      "required": ["code", "severity", "path", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 100},
        "severity": {"enum": ["warning", "block"]},
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "message": {"type": "string", "minLength": 1, "maxLength": 1000}
      },
      "additionalProperties": false
    }
  }
}
