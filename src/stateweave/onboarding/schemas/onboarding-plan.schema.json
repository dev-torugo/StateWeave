{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stateweave:onboarding:plan:1",
  "title": "StateWeave onboarding plan 1",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "status",
    "project_id",
    "project_name",
    "sidecar_policy",
    "adoption_plan",
    "states",
    "risks",
    "decisions",
    "pending_decisions",
    "actions",
    "plan_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "onboarding_plan"},
    "id": {"type": "string", "pattern": "^ONP-[a-f0-9]{64}$"},
    "status": {"enum": ["ready", "blocked", "deferred", "complete"]},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "project_name": {"type": "string", "minLength": 1, "maxLength": 200},
    "sidecar_policy": {"enum": ["tracked", "local", "defer"]},
    "adoption_plan": {"type": "object"},
    "states": {
      "type": "array",
      "minItems": 4,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["code", "value"],
        "properties": {
          "code": {"$ref": "#/$defs/slug"},
          "value": {"type": "string", "minLength": 1, "maxLength": 200}
        },
        "additionalProperties": false
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": {"$ref": "#/$defs/slug"},
          "severity": {"enum": ["info", "warning", "block"]},
          "message": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["code", "choice", "basis"],
        "properties": {
          "code": {"$ref": "#/$defs/slug"},
          "choice": {"type": "string", "minLength": 1, "maxLength": 200},
          "basis": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "additionalProperties": false
      }
    },
    "pending_decisions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["code", "options", "requires_human_confirmation"],
        "properties": {
          "code": {"$ref": "#/$defs/slug"},
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/slug"}
          },
          "requires_human_confirmation": {"const": true}
        },
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "code",
          "mutation",
          "path",
          "requires_human_confirmation"
        ],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "code": {"$ref": "#/$defs/slug"},
          "mutation": {"enum": ["none", "create"]},
          "path": {"type": ["string", "null"], "maxLength": 4096},
          "requires_human_confirmation": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "plan_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"}
  }
}
