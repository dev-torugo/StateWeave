{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stateweave:continuity:memory-candidate:1",
  "title": "StateWeave untrusted memory candidate 1",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "status",
    "request_sha256",
    "idempotency_key_sha256",
    "captured_at",
    "classification",
    "confidence",
    "review_required",
    "operation",
    "expected_sha256",
    "source",
    "provenance",
    "proposed_record",
    "proposed_record_sha256",
    "content_findings",
    "promotion"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "memory_candidate"},
    "id": {"type": "string", "pattern": "^CND-[a-f0-9]{64}$"},
    "status": {"enum": ["pending", "promoted", "rejected"]},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "idempotency_key_sha256": {"$ref": "#/$defs/sha256"},
    "captured_at": {"type": "string", "format": "date-time"},
    "classification": {"$ref": "#/$defs/slug"},
    "confidence": {"enum": ["low", "medium", "high"]},
    "review_required": {"type": "boolean"},
    "operation": {"enum": ["create", "update"]},
    "expected_sha256": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/sha256"}
      ]
    },
    "source": {
      "type": "object",
      "required": ["type", "locator", "observed_at"],
      "properties": {
        "type": {"$ref": "#/$defs/slug"},
        "locator": {"type": "string", "minLength": 1, "maxLength": 4096},
        "observed_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "repository_revision",
        "tree_sha256",
        "artifact_path",
        "artifact_sha256",
        "selector",
        "as_of",
        "extraction_method",
        "observer",
        "derivation_ids"
      ],
      "properties": {
        "repository_revision": {"type": ["string", "null"], "maxLength": 200},
        "tree_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "artifact_path": {"type": ["string", "null"], "maxLength": 4096},
        "artifact_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "selector": {"type": ["string", "null"], "maxLength": 1000},
        "as_of": {"type": ["string", "null"], "format": "date-time"},
        "extraction_method": {"$ref": "#/$defs/slug"},
        "observer": {"$ref": "#/$defs/slug"},
        "derivation_ids": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 200,
          "items": {
            "type": "string",
            "pattern": "^(?:CND|RCP|EVL)-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$|^CTX-[a-f0-9]{64}$"
          }
        }
      },
      "additionalProperties": false
    },
    "proposed_record": {"type": "object"},
    "proposed_record_sha256": {"$ref": "#/$defs/sha256"},
    "content_findings": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["code", "severity", "path", "message"],
        "properties": {
          "code": {"$ref": "#/$defs/slug"},
          "severity": {"enum": ["warning", "block"]},
          "path": {"type": "string", "minLength": 1, "maxLength": 4096},
          "message": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "additionalProperties": false
      }
    },
    "promotion": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": [
            "record_id",
            "record_sha256",
            "transaction_id",
            "reviewer_role",
            "promoted_at"
          ],
          "properties": {
            "record_id": {"$ref": "#/$defs/recordId"},
            "record_sha256": {"$ref": "#/$defs/sha256"},
            "transaction_id": {"type": "string", "pattern": "^IDEM-[a-f0-9]{64}$"},
            "reviewer_role": {"$ref": "#/$defs/slug"},
            "promoted_at": {"type": "string", "format": "date-time"}
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "create"}}},
      "then": {"properties": {"expected_sha256": {"type": "null"}}}
    },
    {
      "if": {"properties": {"operation": {"const": "update"}}},
      "then": {"properties": {"expected_sha256": {"type": "string"}}}
    },
    {
      "if": {"properties": {"status": {"const": "promoted"}}},
      "then": {"properties": {"promotion": {"type": "object"}}}
    },
    {
      "if": {"properties": {"status": {"enum": ["pending", "rejected"]}}},
      "then": {"properties": {"promotion": {"type": "null"}}}
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "recordId": {
      "type": "string",
      "pattern": "^(?:(?:FCT|DEC)-[A-Za-z0-9][A-Za-z0-9._-]{1,127}|STATE-current)$"
    }
  }
}
