{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stateweave:continuity:episodic-ledger:1",
  "title": "StateWeave atomic episodic ledger 1",
  "type": "object",
  "required": ["schema_version", "kind", "documents_sha256", "documents"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"enum": ["orchestration_ledger", "workflow_ledger"]},
    "documents_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "documents": {
      "type": "array",
      "maxItems": 100000,
      "items": {"type": "object"}
    }
  },
  "additionalProperties": false
}
