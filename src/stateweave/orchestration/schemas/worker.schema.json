{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stateweave:orchestration:worker:1.0",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "role",
    "capabilities",
    "risk_ceiling",
    "priority",
    "runtime_adapter"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "worker"},
    "id": {"type": "string", "pattern": "^WKR-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"},
    "role": {"$ref": "#/$defs/slug"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/slug"}
    },
    "risk_ceiling": {"enum": ["low", "moderate", "high", "critical"]},
    "priority": {"type": "integer", "minimum": 0, "maximum": 1000},
    "runtime_adapter": {"$ref": "#/$defs/slug"}
  },
  "additionalProperties": false,
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"}
  }
}
