{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stateweave:schema:transaction:1",
  "title": "StateWeave durable record transaction 1",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "id",
    "status",
    "request_sha256",
    "idempotency_key_sha256",
    "created_at",
    "updated_at",
    "error_type",
    "recovered_at",
    "changes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "transaction"
    },
    "id": {
      "type": "string",
      "pattern": "^(?:TXN-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{16}|IDEM-[a-f0-9]{64})$"
    },
    "status": {
      "enum": [
        "preparing",
        "prepared",
        "applying",
        "committed",
        "rolled_back"
      ]
    },
    "request_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "idempotency_key_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "error_type": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 200
    },
    "recovered_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "index",
          "record_id",
          "path",
          "before_sha256",
          "after_sha256"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999999
          },
          "record_id": {
            "type": "string",
            "pattern": "^(?:(?:FCT|DEC)-[A-Za-z0-9][A-Za-z0-9._-]{1,127}|STATE-current)$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:]+$"
          },
          "before_sha256": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/sha256"
              }
            ]
          },
          "after_sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
